    ("Buds2 Pro", "Galaxy Buds2 Pro", "buds2pro", UUID_SPP_NEW, set()),
    ("Buds Core", "Galaxy Buds Core", "budsfe", UUID_SPP_NEW, set()),
    ("Buds Live", "Galaxy Buds Live", "legacy", UUID_SPP_STANDARD, set()),
    ("Buds Pro", "Galaxy Buds Pro", "budspro", UUID_SPP_STANDARD, set()),
    ("Buds FE", "Galaxy Buds FE", "budsfe", UUID_SPP_NEW, set()),
    ("Buds4", "Galaxy Buds4", "buds3", UUID_SPP_NEW, set()),
    ("Buds3", "Galaxy Buds3", "buds3", UUID_SPP_NEW, set()),

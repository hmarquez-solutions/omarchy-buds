    ("Buds+", "Galaxy Buds+", "legacy", UUID_SPP_STANDARD, set()),
]

# What each payload family can be asked to do. The 2019 Galaxy Buds use a
# different frame header entirely and are not supported.
FAMILY_FEATURES = {
    "buds3": {"noise_control", "ambient_volume", "one_bud_anc", "conversation_detect", "touch_lock", "equalizer", "find", "charging_state", "advanced_touch_lock", "call_touch_lock"},
    "budsfe": {"noise_control", "ambient_volume", "one_bud_anc", "conversation_detect", "touch_lock", "equalizer", "find", "charging_state", "advanced_touch_lock", "call_touch_lock"},
    "buds2pro": {"noise_control", "ambient_volume", "one_bud_anc", "conversation_detect", "touch_lock", "equalizer", "find", "charging_state", "advanced_touch_lock", "call_touch_lock"},
    "buds2": {"noise_control", "ambient_volume", "one_bud_anc", "touch_lock", "equalizer", "find", "charging_state", "advanced_touch_lock"},
    "budspro": {"noise_control", "ambient_volume", "one_bud_anc", "conversation_detect", "touch_lock", "equalizer", "find"},
    "legacy": {"touch_lock", "equalizer", "find"},
    "generic": {"noise_control", "ambient_volume", "equalizer", "find"},
}

# Top ambient level per family (levels run from 0). The Buds3 generation moved
# from three steps to five; a Buds4 Pro reports 4 with nothing else enabled.
AMBIENT_VOLUME_MAX = {"budspro": 3, "buds3": 4}


def identify(name: str):
    for fragment, label, family, uuid, extra in MODELS:
        if fragment in name:
            return {"label": label, "family": family, "uuid": uuid, "features": FAMILY_FEATURES[family] | extra}
    if "Buds" in name:
        return {"label": "Galaxy Buds", "family": "generic", "uuid": UUID_SPP_NEW, "features": FAMILY_FEATURES["generic"]}
    return None


# ---------------------------------------------------------------------------
# Device state
# ---------------------------------------------------------------------------


def _bud(level=None, placement="disconnected", charging=False):
    return {"level": level, "placement": placement, "charging": charging}


class BudsState:
    def __init__(self) -> None:
        self.reset()

    def reset(self) -> None:
        self.connected = False
        self.name = ""
        self.address = ""
        self.model = None
        self.revision = 0
        self.left = _bud()
        self.right = _bud()
        self.case = {"level": None, "charging": False}
        self.noise_mode = None
        self.ambient_volume = None
        self.extra_high_ambient = False
        self.one_bud_anc = None
        self.conversation_detect = None
        self.touch_locked = None
        self.touch_flags = 0x0F  # single, double, triple, hold all on
        self.eq_preset = None
        self.finding = False

    @property
    def features(self) -> set:
        return self.model["features"] if self.model else set()

    def supports(self, feature: str) -> bool:
        return feature in self.features

    def wearing(self) -> bool:
        return self.left["placement"] == "wearing" or self.right["placement"] == "wearing"

    def available_noise_modes(self) -> list[str]:
        if not self.supports("noise_control"):
            return []
        modes = ["off", "anc", "ambient"]
        if self.supports("adaptive") or self.noise_mode == "adaptive":
            modes.append("adaptive")
        return modes

    # -- decoding ---------------------------------------------------------

    def _apply_placement(self, byte: int) -> None:
        self.left["placement"] = PLACEMENTS.get(byte >> 4, "disconnected")
        self.right["placement"] = PLACEMENTS.get(byte & 0x0F, "disconnected")

    def _apply_charging(self, byte: int) -> None:
        self.left["charging"] = bool(byte & 0x10)
        self.right["charging"] = bool(byte & 0x04)
        self.case["charging"] = bool(byte & 0x01)

    @staticmethod
    def _level(raw: int, placement: str):
        if placement == "disconnected":
            return None
        return max(0, min(100, raw))

    def _finish_levels(self, left_raw, right_raw, case_raw) -> None:
        self.left["level"] = self._level(left_raw, self.left["placement"])
        self.right["level"] = self._level(right_raw, self.right["placement"])
        self.case["level"] = None if case_raw > 100 else case_raw

    def apply_status(self, p: bytes) -> None:
        """STATUS_UPDATED: the short battery/placement heartbeat."""
        if len(p) < 7:
            return
        self._apply_placement(p[5])
        if self.supports("charging_state") and len(p) > 7:
            self._apply_charging(p[7])
        self._finish_levels(p[1], p[2], p[6])

    def apply_extended_status(self, p: bytes) -> None:
        """EXTENDED_STATUS_UPDATED: everything, sent on connect and on change."""
        if len(p) < 13:
            return
        self.revision = p[0]
        self._apply_placement(p[6])
        self._finish_levels(p[2], p[3], p[7])
        self.eq_preset = "off" if p[9] == 0 else EQ_PRESETS[min(p[9] - 1, len(EQ_PRESETS) - 1)]

        if self.supports("advanced_touch_lock"):
            self.touch_flags = p[10] & 0x7F
            self.touch_locked = not (p[10] & 0x80)
        else:
            self.touch_locked = p[10] == 1

        family = self.model["family"] if self.model else "generic"
        if family != "legacy":
            self.noise_mode = NOISE_MODES.get(p[12])
        if len(p) > 23 and self.supports("ambient_volume"):
            self.ambient_volume = p[23]

        if family == "budspro":
            if len(p) > 26:
                self.conversation_detect = p[26] == 1
            if self.revision >= 8 and len(p) > 32:
                self.one_bud_anc = p[32] == 1
            if self.revision >= 6 and len(p) > 30:
                self.extra_high_ambient = p[30] == 1
        elif family == "buds2":
            if len(p) > 26:
                self.extra_high_ambient = p[26] == 1
            if self.revision >= 3 and len(p) > 28:
                self.one_bud_anc = p[28] == 1
            if self.revision >= 10 and len(p) > 36:
                self._apply_charging(p[36])
        elif family in ("buds2pro", "budsfe", "buds3"):
            if len(p) > 28:
                self.conversation_detect = p[26] == 1
                self.one_bud_anc = p[28] == 1
            # From byte 34 the layout is a stream of single bytes; these offsets
            # follow GalaxyBudsClient's decoder for each family.
            if family == "buds2pro":
                charging_at = 43 if self.revision >= 11 else None
                extra_high_at = 45 if self.revision >= 13 else None
            elif family == "budsfe":
                charging_at, extra_high_at = 43, None
            else:
                charging_at, extra_high_at = 42, 44
            if charging_at is not None and len(p) > charging_at:
                self._apply_charging(p[charging_at])
            if extra_high_at is not None and len(p) > extra_high_at:
                self.extra_high_ambient = p[extra_high_at] == 1

        # Charging always wins over "idle" for the placement label.
        for bud in (self.left, self.right):
            if bud["charging"] and bud["placement"] in ("idle", "disconnected"):
                bud["placement"] = "case"

    def apply_ack(self, p: bytes) -> None:
        if len(p) < 2:
            return
        msg_id, value = p[0], p[1]
        if msg_id == Msg.NOISE_CONTROLS:
            # Older models echo the mode here; a Buds4 Pro answers 0 as a result
            # code, which would read as Off. The buds announce real mode changes
            # through NOISE_CONTROLS_UPDATE, so this ack is only a receipt.
            return
        if msg_id == Msg.AMBIENT_VOLUME:
            self.ambient_volume = value
        elif msg_id == Msg.SET_DETECT_CONVERSATIONS:
            self.conversation_detect = value == 1
        elif msg_id == Msg.SET_ANC_WITH_ONE_EARBUD:
            self.one_bud_anc = value == 1
        elif msg_id == Msg.EQUALIZER:
            self.eq_preset = "off" if value == 0 else EQ_PRESETS[min(value - 1, len(EQ_PRESETS) - 1)]
        elif msg_id == Msg.EXTRA_HIGH_AMBIENT:
            self.extra_high_ambient = value == 1

    # -- publishing -------------------------------------------------------

    def to_json(self) -> dict:
        model = self.model or {}
        family = model.get("family", "")
        ambient_max = AMBIENT_VOLUME_MAX.get(family, 2) + (1 if self.extra_high_ambient else 0)
        return {
            "schema_version": SCHEMA_VERSION,
            "daemon_version": VERSION,
            "connected": self.connected,
            "device": {
                "name": self.name,
                "address": self.address,
                "model": model.get("label", ""),
                "family": family,
                "revision": self.revision,
            },
            "battery": {"left": dict(self.left), "right": dict(self.right), "case": dict(self.case)},
            "noise": {
                "mode": self.noise_mode,
                "available": self.available_noise_modes(),
                "ambient_volume": self.ambient_volume,
                "ambient_volume_max": ambient_max,
                "extra_high_ambient": self.extra_high_ambient,
                "one_bud_anc": self.one_bud_anc,
                "conversation_detect": self.conversation_detect,
            },
            "touch": {"locked": self.touch_locked},
            "equalizer": {"preset": self.eq_preset, "presets": ["off"] + EQ_PRESETS},
            "find": {"active": self.finding},
            "supports": {f: True for f in sorted(self.features)},
            "updated_at": int(time.time()),
        }


# ---------------------------------------------------------------------------
# Daemon
# ---------------------------------------------------------------------------


def state_dir() -> str:
    return os.environ.get("STATE_DIRECTORY") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"), "omarchy-buds"
    )


def runtime_dir() -> str:
    """The private runtime directory shared by the daemon and its CLI."""
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(base, "omarchy-buds")


def status_path() -> str:
    return os.path.join(state_dir(), "status.json")


def socket_path() -> str:
    return os.path.join(runtime_dir(), "omarchy-buds.sock")


def ensure_private_dir(path: str) -> None:
    """Create a user-owned 0700 directory, refusing links and other owners."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise PermissionError(f"private directory check failed for {path}")
    if stat.S_IMODE(st.st_mode) & 0o077:
        os.chmod(path, 0o700)


def check_private_dir(path: str) -> bool:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077:
        raise PermissionError(f"private directory check failed for {path}")
    return True


def read_status_file() -> bytes:
    """Read status through an opened directory/file descriptor with a size cap."""
    directory_fd = -1
    file_fd = -1
    try:
        directory_fd = os.open(
            state_dir(),
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
        )
        file_fd = os.open("status.json", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0), dir_fd=directory_fd)
        st = os.fstat(file_fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077:
            raise PermissionError("status file ownership or mode check failed")
        data = bytearray()
        while len(data) <= MAX_STATUS_BYTES:
            chunk = os.read(file_fd, min(8192, MAX_STATUS_BYTES + 1 - len(data)))
            if not chunk:
                return bytes(data)
            data.extend(chunk)
        raise ValueError("status file is too large")
    finally:
        if file_fd >= 0:
            os.close(file_fd)
        if directory_fd >= 0:
            os.close(directory_fd)


def control_socket_present() -> bool:
    if not check_private_dir(runtime_dir()):
        return False
    try:
        st = os.lstat(socket_path())
    except FileNotFoundError:
        return False
    if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077:
        raise PermissionError("control socket ownership or mode check failed")
    return True


BLUEZ = "org.bluez"
PROFILE_PATH = "/io/github/hmarquez_solutions/omarchy_buds/Profile"
PROFILE_XML = """
<node>
  <interface name="org.bluez.Profile1">
    <method name="Release"/>
    <method name="NewConnection">
      <arg type="o" name="device" direction="in"/>
      <arg type="h" name="fd" direction="in"/>
      <arg type="a{sv}" name="fd_properties" direction="in"/>
    </method>
    <method name="RequestDisconnection">
      <arg type="o" name="device" direction="in"/>
    </method>
  </interface>
</node>
"""


class Daemon:
    def __init__(self, debug: bool = False) -> None:
        import gi

        gi.require_version("Gio", "2.0")
        gi.require_version("GLib", "2.0")
        from gi.repository import Gio, GLib

        self.Gio, self.GLib = Gio, GLib
        self.debug = debug
        self.state = BudsState()
        self.parser = FrameParser()
        self.sock: socket.socket | None = None
        self.sock_watch = 0
        self.device_path: str | None = None
        self.connect_attempts = 0
        self.registered: set[str] = set()
        self.loop = GLib.MainLoop()
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.bluez_owner: str | None = None
        self.control: socket.socket | None = None
        self.control_clients: dict[int, dict] = {}

    # -- logging ----------------------------------------------------------

    def log(self, msg: str) -> None:
        print(msg, file=sys.stderr, flush=True)

    def dbg(self, msg: str) -> None:
        if self.debug:
            self.log(msg)

    # -- lifecycle --------------------------------------------------------

    def run(self) -> int:
        GLib = self.GLib
        ensure_private_dir(state_dir())
        ensure_private_dir(runtime_dir())
        self.bluez_owner = self.current_bluez_owner()
        self.publish()
        self.open_control_socket()
        for sig in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, self.quit)

        node = self.Gio.DBusNodeInfo.new_for_xml(PROFILE_XML)
        self.bus.register_object(PROFILE_PATH, node.interfaces[0], self.on_profile_call, None, None)

        self.bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.Properties", "PropertiesChanged", None, "org.bluez.Device1",
                                  self.Gio.DBusSignalFlags.NONE, self.on_properties_changed)
        self.bus.signal_subscribe(BLUEZ, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded", "/", None,
                                  self.Gio.DBusSignalFlags.NONE, self.on_interfaces_added)
        self.bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged", None, BLUEZ,
                                  self.Gio.DBusSignalFlags.NONE, self.on_bluez_owner_changed)

        self.setup_bluez()
        self.loop.run()
        return 0

    def quit(self, *_args) -> bool:
        self.log("omarchy-buds: stopping")
        self.drop_link()
        for fd in list(self.control_clients):
            self.close_control_client(fd)
        if self.control:
            self.control.close()
            self.control = None
        try:
            os.unlink(status_path())
        except OSError:
            pass
        try:
            os.unlink(socket_path())
        except OSError:
            pass
        self.loop.quit()
        return False

    # -- private paths ----------------------------------------------------

    def _open_private_dir(self, path: str) -> int:
        ensure_private_dir(path)
        flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
        flags |= getattr(os, "O_CLOEXEC", 0)
        fd = os.open(path, flags)
        try:
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077:
                raise PermissionError(f"private directory check failed for {path}")
            return fd
        except Exception:
            os.close(fd)
            raise

    # -- BlueZ ------------------------------------------------------------

    def current_bluez_owner(self) -> str | None:
        """Return BlueZ's unique bus name, never the spoofable well-known name."""
        try:
            return self.bus.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetNameOwner",
                self.GLib.Variant("(s)", (BLUEZ,)),
                self.GLib.VariantType("(s)"),
                self.Gio.DBusCallFlags.NONE,
                2000,
                None,
            )[0]
        except Exception:  # noqa: BLE001
            return None

    def call(self, path: str, iface: str, method: str, params=None, reply_type: str | None = None):
        GLib = self.GLib
        return self.bus.call_sync(BLUEZ, path, iface, method, params,
                                  GLib.VariantType(reply_type) if reply_type else None,
                                  self.Gio.DBusCallFlags.NONE, 15000, None)

    def setup_bluez(self) -> bool:
        """Register our profiles and attach to any buds that are already connected.

        Returns True to be re-run by a timer while BlueZ is unavailable.
        """
        GLib = self.GLib
        try:
            for uuid in (UUID_SPP_NEW, UUID_SPP_STANDARD):
                if uuid in self.registered:
                    continue
                opts = {"Role": GLib.Variant("s", "client"), "Name": GLib.Variant("s", "omarchy-buds"),
                        # Only Samsung's private UUID is safe to auto-connect; the generic
                        # serial UUID is shared by unrelated gadgets.
                        "AutoConnect": GLib.Variant("b", uuid == UUID_SPP_NEW)}
                try:
                    self.call("/org/bluez", "org.bluez.ProfileManager1", "RegisterProfile",
                              GLib.Variant("(osa{sv})", (PROFILE_PATH, uuid, opts)))
                except Exception as exc:  # noqa: BLE001
                    if "AlreadyExists" not in str(exc):
                        raise
                self.registered.add(uuid)
            self.log("omarchy-buds: profiles registered with BlueZ")
        except Exception as exc:  # noqa: BLE001
            self.log(f"omarchy-buds: BlueZ not ready ({exc}); retrying in 10s")
            GLib.timeout_add_seconds(10, self.setup_bluez)
            return False

        self.scan_devices()
        return False

    def scan_devices(self) -> None:
        try:
            managed = self.call("/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects", None, "(a{oa{sa{sv}}})")[0]
        except Exception as exc:  # noqa: BLE001
            self.log(f"omarchy-buds: GetManagedObjects failed: {exc}")
            return
        for path, ifaces in managed.items():
            dev = ifaces.get("org.bluez.Device1")
            if dev and dev.get("Connected"):
                self.consider_device(path, dev)

    def consider_device(self, path: str, props: dict) -> None:
        try:
            name, model = self.validate_device(path, props)
        except ValueError as exc:
            self.dbg(f"omarchy-buds: ignoring device {path}: {exc}")
            return
        if self.sock and self.device_path == path:
            return
        if self.sock:
            self.dbg(f"omarchy-buds: ignoring {name}; already linked to {self.state.name}")
            return
        self.device_path = path
        self.state.name = name
        self.state.address = props.get("Address", "")
        self.state.model = model
        self.connect_attempts = 0
        self.log(f"omarchy-buds: {name} ({model['label']}) is connected; opening control link")
        self.connect_profile()

    def validate_device(self, path: str, props: dict) -> tuple[str, dict]:
        """Accept only a paired, trusted, connected Galaxy Buds Device1."""
        if not isinstance(path, str) or not path.startswith("/org/bluez/"):
            raise ValueError("invalid BlueZ device path")
        if props.get("Connected") is not True:
            raise ValueError("device is not connected")
        if props.get("Paired") is not True:
            raise ValueError("device is not paired")
        if props.get("Trusted") is not True:
            raise ValueError("device is not trusted")
        name = props.get("Alias") or props.get("Name") or ""
        if not isinstance(name, str) or not name:
            raise ValueError("device has no name")
        name = name[:MAX_DEVICE_NAME_CHARS]
        model = identify(name)
        if not model:
            raise ValueError("device is not a supported Galaxy Buds model")
        uuids = props.get("UUIDs") or []
        if not isinstance(uuids, (list, tuple, set)) or model["uuid"] not in uuids:
            raise ValueError("device does not expose the expected SPP profile")
        return name, model

    def connect_profile(self) -> bool:
        """Ask BlueZ to open the SPP profile. Asynchronous: BlueZ can take many
        seconds to answer and the main loop must keep serving reads meanwhile."""
        if not self.device_path or self.sock:
            return False
        uuid = self.state.model["uuid"]
        device_path = self.device_path

        def done(bus, result):
            try:
                bus.call_finish(result)
            except Exception as exc:  # noqa: BLE001
                text = str(exc)
                if device_path != self.device_path or self.sock:
                    return
                if "InProgress" in text or "AlreadyConnected" in text:
                    return
                self.connect_attempts += 1
                if self.connect_attempts <= 10:
                    self.dbg(f"omarchy-buds: ConnectProfile failed ({text}); attempt {self.connect_attempts}/10")
                    self.GLib.timeout_add(1500, self.connect_profile)
                else:
                    self.log(f"omarchy-buds: giving up on the control link: {text}")

        self.bus.call(BLUEZ, device_path, "org.bluez.Device1", "ConnectProfile", self.GLib.Variant("(s)", (uuid,)),
                      None, self.Gio.DBusCallFlags.NONE, 30000, None, done)
        return False

    def on_properties_changed(self, _conn, _sender, path, _iface, _signal, params) -> None:
        _iface_name, changed, _invalidated = params.unpack()
        if "Connected" not in changed:
            return
        if changed["Connected"]:
            try:
                props = self.call(path, "org.freedesktop.DBus.Properties", "GetAll",
                                  self.GLib.Variant("(s)", ("org.bluez.Device1",)), "(a{sv})")[0]
            except Exception:  # noqa: BLE001
                return
            self.consider_device(path, props)
        elif path == self.device_path:
            self.log(f"omarchy-buds: {self.state.name} disconnected")
            self.drop_link()
            self.device_path = None
            self.state.reset()
            self.publish()

    def on_interfaces_added(self, _conn, _sender, _path, _iface, _signal, params) -> None:
        path, ifaces = params.unpack()
        dev = ifaces.get("org.bluez.Device1")
        if dev and dev.get("Connected"):
            self.consider_device(path, dev)

    def on_bluez_owner_changed(self, _conn, _sender, _path, _iface, _signal, params) -> None:
        _name, _old, new = params.unpack()
        self.bluez_owner = new or None
        self.registered.clear()
        if new:
            self.log("omarchy-buds: BlueZ appeared; registering")
            self.GLib.timeout_add_seconds(2, self.setup_bluez)
        else:
            self.drop_link()
            self.device_path = None
            self.state.reset()
            self.publish()

    # -- Profile1 ---------------------------------------------------------

    def reject_profile_call(self, invocation, message: str) -> None:
        invocation.return_dbus_error("org.bluez.Error.Rejected", message[:256])

    def on_profile_call(self, _conn, sender, _path, _iface, method, params, invocation) -> None:
        # Profile1 is exported on the system bus. The passed Unix FD is a
        # capability, so authenticate the sender before unpacking parameters
        # or touching the FD list. BlueZ's well-known name is not enough:
        # another process may own it after a restart.
        if not sender or sender != self.bluez_owner:
            self.reject_profile_call(invocation, "profile callback is not from the current BlueZ owner")
            return

        if method == "NewConnection":
            fd = None
            try:
                device, fd_index, _props = params.unpack()
                fd_list = invocation.get_message().get_unix_fd_list()
                if fd_list is None or not isinstance(fd_index, int) or fd_index < 0:
                    raise ValueError("missing or invalid Bluetooth socket descriptor")
                fd = fd_list.get(fd_index)
                if not isinstance(fd, int) or fd < 0:
                    raise ValueError("missing or invalid Bluetooth socket descriptor")
                self.on_new_connection(device, fd)
                fd = None  # on_new_connection now owns an accepted descriptor
                invocation.return_value(None)
            except (OSError, ValueError, RuntimeError) as exc:
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                self.reject_profile_call(invocation, str(exc) or "invalid Bluetooth connection")
            except Exception as exc:  # noqa: BLE001
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                self.log(f"omarchy-buds: rejected malformed Profile1 call: {exc}")
                self.reject_profile_call(invocation, "invalid Bluetooth connection")
        elif method == "RequestDisconnection":
            try:
                device = params.unpack()[0]
                if device != self.device_path:
                    raise ValueError("disconnection is for an unknown device")
                invocation.return_value(None)
                self.drop_link()
                self.publish()
            except (OSError, ValueError, RuntimeError) as exc:
                self.reject_profile_call(invocation, str(exc) or "invalid disconnection")
            except Exception as exc:  # noqa: BLE001
                self.log(f"omarchy-buds: rejected malformed disconnection call: {exc}")
                self.reject_profile_call(invocation, "invalid disconnection")
        else:
            invocation.return_value(None)

    def on_new_connection(self, device: str, fd: int) -> None:
        if self.sock:
            raise RuntimeError("a Bluetooth control link is already active")
        props = self.call(device, "org.freedesktop.DBus.Properties", "GetAll",
                          self.GLib.Variant("(s)", ("org.bluez.Device1",)), "(a{sv})")[0]
        name, model = self.validate_device(device, props)
        if self.device_path and device != self.device_path:
            raise ValueError("link offered for a different device")
        sock = self.validated_bluetooth_socket(fd)
        sock.setblocking(False)

        self.device_path = device
        self.state.name = name
        self.state.address = props.get("Address", "")
        self.state.model = model
        self.sock = sock
        self.parser = FrameParser()
        self.sock_watch = self.GLib.io_add_watch(self.sock.fileno(), self.GLib.PRIORITY_DEFAULT,
                                                 self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR, self.on_readable)
        self.state.connected = True
        self.log(f"omarchy-buds: control link up with {self.state.name}")
        # Introduce ourselves the way the Samsung app does; the buds answer with
        # an extended status.
        self.send(Msg.MANAGER_INFO, bytes([1, 1, 34]))
        self.publish()

    def validated_bluetooth_socket(self, fd: int) -> socket.socket:
        """Validate BlueZ's passed descriptor without consuming it on failure."""
        if not isinstance(fd, int) or fd < 0:
            raise ValueError("invalid Bluetooth socket descriptor")
        probe = None
        try:
            duplicate = os.dup(fd)
            probe = socket.socket(fileno=duplicate)
            st = os.fstat(probe.fileno())
            if not stat.S_ISSOCK(st.st_mode):
                raise ValueError("Profile1 descriptor is not a socket")
            try:
                socket_type = probe.getsockopt(socket.SOL_SOCKET, socket.SO_TYPE)
                domain = probe.getsockopt(socket.SOL_SOCKET, getattr(socket, "SO_DOMAIN", 39))
                probe.getpeername()
            except OSError as exc:
                raise ValueError("Profile1 descriptor is not a connected socket") from exc
            if socket_type != socket.SOCK_STREAM:
                raise ValueError("Profile1 descriptor is not a stream socket")
            if domain != getattr(socket, "AF_BLUETOOTH", -1):
                raise ValueError("Profile1 descriptor is not a Bluetooth socket")
            os.set_inheritable(fd, False)
        finally:
            if probe is not None:
                probe.close()
        return socket.socket(getattr(socket, "AF_BLUETOOTH", socket.AF_UNIX), socket.SOCK_STREAM, fileno=fd)

    def drop_link(self) -> None:
        if self.sock_watch:
            self.GLib.source_remove(self.sock_watch)
            self.sock_watch = 0
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None
        self.state.connected = False
        self.state.finding = False

    def on_readable(self, _fd, cond) -> bool:
        if cond & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.log("omarchy-buds: control link closed")
            self.drop_link()
            self.publish()
            return False
        try:
            data = self.sock.recv(4096)
        except BlockingIOError:
            return True
        except OSError as exc:
            self.log(f"omarchy-buds: read failed: {exc}")
            self.drop_link()
            self.publish()
            return False
        if not data:
            self.log("omarchy-buds: control link closed by the buds")
            self.drop_link()
            self.publish()
            return False
        changed = False
        for msg_id, payload, is_response in self.parser.feed(data):
            self.dbg(f"<< id={msg_id} resp={int(is_response)} payload={payload.hex(' ')}")
            changed |= self.handle(msg_id, payload)
        if changed:
            self.publish()
        return True

    def handle(self, msg_id: int, payload: bytes) -> bool:
        s = self.state
        if msg_id == Msg.STATUS_UPDATED:
            s.apply_status(payload)
        elif msg_id == Msg.EXTENDED_STATUS_UPDATED:
            s.apply_extended_status(payload)
        elif msg_id == Msg.NOISE_CONTROLS_UPDATE:
            if payload:
                s.noise_mode = NOISE_MODES.get(payload[0], s.noise_mode)
        elif msg_id == Msg.AMBIENT_VOLUME:
            if payload:
                s.ambient_volume = payload[0]
        elif msg_id == Msg.ACK:
            s.apply_ack(payload)
        elif msg_id in (Msg.FIND_MY_EARBUDS_STOP,):
            s.finding = False
        elif msg_id == Msg.TOUCH_ON_BUDS:
            # A gesture happened on a bud. Some models push a NOISE_CONTROLS_UPDATE
            # (id 119) of their own after one; those are handled above. The Buds4
            # Pro send neither that nor this on a pinch, so re-sending the
            # handshake here is a harmless best effort for the models that do
            # answer it with a fresh status. See "Known limitations" in README.
            self.request_status()
            return False
        else:
            return False
        return True

    # -- status refresh ---------------------------------------------------
    #
    # Nothing in the protocol asks for a status: the buds send one when the
    # control link opens and after some changes. Re-sending MANAGER_INFO is the
    # one nudge that is safe to repeat on a live link; if a given model answers
    # it with a fresh EXTENDED_STATUS_UPDATED, a gesture-driven change shows up.
    # Tearing the link down to force one is deliberately not done: it drops the
    # audio profile and BlueZ will not always bring it back.

    _status_poll = 0

    def request_status(self, delay_ms: int = 350) -> None:
        if self._status_poll:
            self.GLib.source_remove(self._status_poll)
        self._status_poll = self.GLib.timeout_add(delay_ms, self._poll_now)

    def _poll_now(self) -> bool:
        self._status_poll = 0
        if self.sock:
            try:
                self.send(Msg.MANAGER_INFO, bytes([1, 1, 34]))
            except OSError as exc:
                self.log(f"omarchy-buds: status poll failed: {exc}")
        return False

    def send(self, msg_id: int, payload: bytes = b"", flags: int = 0) -> None:
        if not self.sock:
            raise RuntimeError("buds are not connected")
        frame = encode(msg_id, payload, flags)
        self.dbg(f">> id={msg_id} flags={flags:#x} payload={payload.hex(' ')}")
        self.sock.sendall(frame)

    # -- status file ------------------------------------------------------

    def publish(self) -> None:
        directory_fd = -1
        temp_fd = -1
        temp_name = None
        try:
            data = json.dumps(self.state.to_json(), separators=(",", ":")).encode("utf-8") + b"\n"
            if len(data) > MAX_STATUS_BYTES:
                self.log(f"omarchy-buds: refusing oversized status ({len(data)} bytes)")
                return
            directory_fd = self._open_private_dir(state_dir())
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
            flags |= getattr(os, "O_CLOEXEC", 0)
            for _ in range(8):
                temp_name = f".status.{secrets.token_hex(12)}"
                try:
                    temp_fd = os.open(temp_name, flags, 0o600, dir_fd=directory_fd)
                    break
                except FileExistsError:
                    temp_name = None
            if temp_fd < 0 or temp_name is None:
                raise OSError(errno.EEXIST, "could not create a private status temporary file")
            with os.fdopen(temp_fd, "wb") as fh:
                temp_fd = -1
                fh.write(data)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(temp_name, "status.json", src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
            temp_name = None
            os.fsync(directory_fd)
        except (OSError, ValueError, TypeError) as exc:
            self.log(f"omarchy-buds: cannot write {status_path()}: {exc}")
        finally:
            if temp_fd >= 0:
                os.close(temp_fd)
            if directory_fd >= 0:
                if temp_name is not None:
                    try:
                        os.unlink(temp_name, dir_fd=directory_fd)
                    except OSError:
                        pass
                os.close(directory_fd)

    # -- control socket ---------------------------------------------------

    def open_control_socket(self) -> None:
        path = socket_path()
        try:
            existing = os.lstat(path)
        except FileNotFoundError:
            existing = None
        if existing is not None:
            if not stat.S_ISSOCK(existing.st_mode) or existing.st_uid != os.getuid() or stat.S_IMODE(existing.st_mode) & 0o077:
                raise PermissionError(f"refusing to replace an unrelated control path: {path}")
            os.unlink(path)
        ensure_private_dir(runtime_dir())
        self.control = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.control.bind(path)
        os.chmod(path, 0o600)
        self.control.listen(MAX_CONTROL_CLIENTS)
        self.control.setblocking(False)
        self.GLib.io_add_watch(self.control.fileno(), self.GLib.PRIORITY_DEFAULT, self.GLib.IO_IN, self.on_control_readable)

    def on_control_readable(self, _fd, _cond) -> bool:
        while True:
            try:
                conn, _ = self.control.accept()
            except BlockingIOError:
                break
            except OSError:
                return True
            if len(self.control_clients) >= MAX_CONTROL_CLIENTS:
                conn.close()
                continue
            conn.setblocking(False)
            client = {"sock": conn, "input": bytearray(), "output": bytearray(), "done": False, "watch": 0, "timer": 0}
            fd = conn.fileno()
            self.control_clients[fd] = client
            client["timer"] = self.GLib.timeout_add(CONTROL_TIMEOUT_MS, self.on_control_timeout, fd)
            self.set_control_client_watch(fd)
        return True

    def set_control_client_watch(self, fd: int) -> None:
        client = self.control_clients.get(fd)
        if not client:
            return
        if client["watch"]:
            self.GLib.source_remove(client["watch"])
        events = self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR
        if client["output"]:
            events |= self.GLib.IO_OUT
        client["watch"] = self.GLib.io_add_watch(client["sock"].fileno(), self.GLib.PRIORITY_DEFAULT, events, self.on_control_client)

    def close_control_client(self, fd: int) -> None:
        client = self.control_clients.pop(fd, None)
        if not client:
            return
        if client["watch"]:
            self.GLib.source_remove(client["watch"])
        if client["timer"]:
            self.GLib.source_remove(client["timer"])
        try:
            client["sock"].close()
        except OSError:
            pass

    def on_control_timeout(self, fd: int) -> bool:
        self.close_control_client(fd)
        return False

    def control_reply(self, client: dict, reply: dict) -> None:
        if client["done"]:
            return
        try:
            encoded = json.dumps(reply, separators=(",", ":")).encode("utf-8") + b"\n"
        except (TypeError, ValueError):
            encoded = b'{"ok":false,"error":"invalid daemon reply"}\n'
        if len(encoded) > MAX_REPLY_BYTES:
            encoded = b'{"ok":false,"error":"daemon reply too large"}\n'
        client["done"] = True
        client["output"] = bytearray(encoded)
        self.set_control_client_watch(client["sock"].fileno())

    def read_control_client(self, fd: int) -> None:
        client = self.control_clients.get(fd)
        if not client or client["done"]:
            return
        sock = client["sock"]
        while True:
            try:
                chunk = sock.recv(min(4096, MAX_COMMAND_BYTES + 1 - len(client["input"])))
            except BlockingIOError:
                return
            except OSError:
                self.close_control_client(fd)
                return
            if not chunk:
                if client["input"]:
                    self.control_reply(client, {"ok": False, "error": "incomplete command"})
                else:
                    self.close_control_client(fd)
                return
            client["input"].extend(chunk)
            newline = client["input"].find(b"\n")
            if newline >= 0:
                trailing = client["input"][newline + 1:]
                if trailing:
                    self.control_reply(client, {"ok": False, "error": "multiple commands are not allowed"})
                    return
                try:
                    line = bytes(client["input"][:newline]).decode("utf-8")
                except UnicodeDecodeError:
                    self.control_reply(client, {"ok": False, "error": "command is not valid UTF-8"})
                    return
                try:
                    reply = self.command(line.strip().split())
                except Exception as exc:  # noqa: BLE001
                    self.log(f"omarchy-buds: control command failed: {exc}")
                    reply = {"ok": False, "error": "command failed"}
                self.control_reply(client, reply)
                return
            if len(client["input"]) >= MAX_COMMAND_BYTES:
                self.control_reply(client, {"ok": False, "error": "command is too large"})
                return

    def write_control_client(self, fd: int) -> None:
        client = self.control_clients.get(fd)
        if not client:
            return
        try:
            while client["output"]:
                sent = client["sock"].send(client["output"])
                if sent <= 0:
                    self.close_control_client(fd)
                    return
                del client["output"][:sent]
        except BlockingIOError:
            return
        except OSError:
            self.close_control_client(fd)
            return
        if not client["output"]:
            self.close_control_client(fd)

    def on_control_client(self, fd, cond) -> bool:
        if fd not in self.control_clients:
            return False
        if cond & (self.GLib.IO_HUP | self.GLib.IO_ERR):
            self.close_control_client(fd)
            return False
        if cond & self.GLib.IO_IN:
            self.read_control_client(fd)
        if fd in self.control_clients and cond & self.GLib.IO_OUT:
            self.write_control_client(fd)
        return fd in self.control_clients

    def command(self, argv: list[str]) -> dict:
        s = self.state
        if not argv:
            return {"ok": False, "error": "empty command"}
        verb, args = argv[0], argv[1:]

        if verb == "status":
            return {"ok": True, "status": s.to_json()}
        if verb == "refresh":
            if s.connected:
                self.request_status(0)
            self.publish()
            return {"ok": True}
        if verb == "ping":
            return {"ok": True, "version": VERSION}

        if not s.connected:
            return {"ok": False, "error": "buds are not connected"}

        def need(feature: str) -> None:
            if not s.supports(feature):
                raise ValueError(f"{s.model['label']} does not support {feature.replace('_', ' ')}")

        def flag(value: str) -> bool:
            if value in ("on", "1", "true"):
                return True
            if value in ("off", "0", "false"):
                return False
            raise ValueError(f"expected on or off, got {value!r}")

        try:
            if verb == "noise":
                need("noise_control")
                mode = args[0] if args else ""
                if mode == "cycle":
                    modes = s.available_noise_modes()
                    at = modes.index(s.noise_mode) if s.noise_mode in modes else -1
                    mode = modes[(at + 1) % len(modes)]
                if mode not in s.available_noise_modes():
                    raise ValueError(f"mode must be one of {', '.join(s.available_noise_modes())}")
                self.send(Msg.NOISE_CONTROLS, bytes([NOISE_MODE_IDS[mode]]))
                s.noise_mode = mode
            elif verb == "ambient-volume":
                need("ambient_volume")
                level = max(0, min(AMBIENT_VOLUME_MAX.get(s.model["family"], 2) + (1 if s.extra_high_ambient else 0), int(args[0])))
                self.send(Msg.AMBIENT_VOLUME, bytes([level]))
                s.ambient_volume = level
            elif verb == "conversation":
                need("conversation_detect")
                on = flag(args[0])
                self.send(Msg.SET_DETECT_CONVERSATIONS, bytes([int(on)]))
                s.conversation_detect = on
            elif verb == "onebud":
                need("one_bud_anc")
                on = flag(args[0])
                self.send(Msg.SET_ANC_WITH_ONE_EARBUD, bytes([int(on)]))
                s.one_bud_anc = on
            elif verb == "touch-lock":
                need("touch_lock")
                lock = flag(args[0])
                if s.supports("advanced_touch_lock"):
                    f = s.touch_flags
                    # [unlocked, single, double, triple, hold(, double-for-call, hold-for-call)]
                    payload = [int(not lock), f >> 3 & 1, f >> 2 & 1, f >> 1 & 1, f & 1]
                    if s.supports("call_touch_lock"):
                        payload += [f >> 4 & 1, f >> 5 & 1]
                    if lock:
                        payload = [0] * len(payload)
                    self.send(Msg.LOCK_TOUCHPAD, bytes(payload))
                else:
                    self.send(Msg.LOCK_TOUCHPAD, bytes([int(lock)]))
                s.touch_locked = lock
            elif verb == "eq":
                need("equalizer")
                preset = args[0] if args else ""
                if preset == "cycle":
                    presets = ["off"] + EQ_PRESETS
                    at = presets.index(s.eq_preset) if s.eq_preset in presets else -1
                    preset = presets[(at + 1) % len(presets)]
                if preset == "off":
                    self.send(Msg.EQUALIZER, bytes([0]))
                elif preset in EQ_PRESETS:
                    self.send(Msg.EQUALIZER, bytes([EQ_PRESETS.index(preset) + 1]))
                else:
                    raise ValueError(f"preset must be one of off, {', '.join(EQ_PRESETS)}")
                s.eq_preset = preset
            elif verb == "find":
                need("find")
                action = args[0] if args else "toggle"
                if action == "toggle":
                    action = "stop" if s.finding else "start"
                if action == "start":
                    if s.wearing():
                        raise ValueError("take the buds out of your ears before ringing them")
                    self.send(Msg.FIND_MY_EARBUDS_START)
                    s.finding = True
                elif action == "stop":
                    self.send(Msg.FIND_MY_EARBUDS_STOP)
                    s.finding = False
                else:
                    raise ValueError("expected start, stop or toggle")
            else:
                return {"ok": False, "error": f"unknown command {verb!r}"}
        except (ValueError, IndexError) as exc:
            return {"ok": False, "error": str(exc) or "missing argument"}
        except (OSError, RuntimeError) as exc:
            return {"ok": False, "error": f"send failed: {exc}"}

        self.publish()
        return {"ok": True}


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

USAGE = """\
usage: omarchy-buds <command> [args]

  daemon [--debug]             run the daemon (normally via omarchy-buds.service)
  status                       print the current status JSON
  noise off|anc|ambient|adaptive|cycle
  ambient-volume <0-3>
  conversation on|off          lower the volume when you start talking
  onebud on|off                keep noise controls on with one bud in
  touch-lock on|off
  eq off|bass|soft|dynamic|clear|treble|cycle
  find start|stop|toggle       ring the buds (refused while worn)
  refresh                      rewrite the status file
"""


def cli(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if argv[0] == "daemon":
        parser = argparse.ArgumentParser(prog="omarchy-buds daemon")
        parser.add_argument("--debug", action="store_true", help="log every frame")
        opts = parser.parse_args(argv[1:])
        return Daemon(debug=opts.debug).run()
    if argv[0] == "--version":
        print(VERSION)
        return 0

    try:
        socket_present = control_socket_present()
    except OSError as exc:
        print(f"omarchy-buds: {exc}", file=sys.stderr)
        return 1

    if argv[0] == "status" and not socket_present:
        try:
            sys.stdout.buffer.write(read_status_file())
            return 0
        except (OSError, ValueError):
            print("omarchy-buds: daemon is not running", file=sys.stderr)
            return 1

    command = " ".join(argv).encode("utf-8")
    if len(command) + 1 > MAX_COMMAND_BYTES:
        print("omarchy-buds: command is too large", file=sys.stderr)
        return 1
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            deadline = time.monotonic() + 5
            sock.connect(socket_path())
            sock.sendall(command + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("daemon reply timed out")
                sock.settimeout(remaining)
                chunk = sock.recv(min(8192, MAX_REPLY_BYTES + 1 - len(data)))
                if not chunk:
                    break
                data += chunk
                if len(data) > MAX_REPLY_BYTES:
                    raise ValueError("daemon reply is too large")
    except OSError as exc:
        print(f"omarchy-buds: daemon is not running ({exc})", file=sys.stderr)
        return 1
    except (TimeoutError, ValueError) as exc:
        print(f"omarchy-buds: {exc}", file=sys.stderr)
        return 1

    try:
        reply = json.loads(data.decode() or "{}")
    except json.JSONDecodeError:
        print("omarchy-buds: garbled reply from the daemon", file=sys.stderr)
        return 1
    if not reply.get("ok"):
        print(f"omarchy-buds: {reply.get('error', 'command failed')}", file=sys.stderr)
        return 1
    if "status" in reply:
        json.dump(reply["status"], sys.stdout, indent=2)
        print()
    return 0


if __name__ == "__main__":
    sys.exit(cli(sys.argv[1:]))

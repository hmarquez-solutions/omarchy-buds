    ("Buds4 Pro", "Galaxy Buds4 Pro", "buds3", UUID_SPP_NEW, {"adaptive"}),
    ("Buds3 Pro", "Galaxy Buds3 Pro", "buds3", UUID_SPP_NEW, {"adaptive"}),

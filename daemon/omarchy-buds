# IPC is deliberately boring and bounded. The panel sends one short command,
# and the daemon returns one small JSON reply. These ceilings are part of the
# protocol, not merely defensive defaults.
MAX_COMMAND_BYTES = 4096
MAX_REPLY_BYTES = 65536
MAX_STATUS_BYTES = 65536
CONTROL_TIMEOUT_MS = 2000
MAX_CONTROL_CLIENTS = 16
MAX_DEVICE_NAME_CHARS = 128

# ---------------------------------------------------------------------------
# Wire protocol
# ---------------------------------------------------------------------------

# Samsung's own SPP service, used by everything from the Buds2 onwards.
UUID_SPP_NEW = "2e73a4ad-332d-41fc-90e2-16bef06523f2"
# The generic Serial Port Profile, used by Buds+, Buds Live and Buds Pro.
UUID_SPP_STANDARD = "00001101-0000-1000-8000-00805f9b34fb"

SOM = 0xFD
EOM = 0xDD


class Msg:
    """SPP message ids, named as Samsung's app names them."""

    DEBUG_GET_ALL_DATA = 38
    TOUCH_ON_BUDS = 45
    ACK = 66
    STATUS_UPDATED = 96
    EXTENDED_STATUS_UPDATED = 97
    SET_ANC_WITH_ONE_EARBUD = 111
    NOISE_CONTROLS_UPDATE = 119
    NOISE_CONTROLS = 120
    SET_DETECT_CONVERSATIONS = 122
    AMBIENT_VOLUME = 132
    EQUALIZER = 134
    MANAGER_INFO = 136
    LOCK_TOUCHPAD = 144
    EXTRA_HIGH_AMBIENT = 150
    FIND_MY_EARBUDS_START = 160
    FIND_MY_EARBUDS_STOP = 161


NOISE_MODES = {0: "off", 1: "anc", 2: "ambient", 3: "adaptive"}
NOISE_MODE_IDS = {v: k for k, v in NOISE_MODES.items()}

EQ_PRESETS = ["bass", "soft", "dynamic", "clear", "treble"]

PLACEMENTS = {0: "disconnected", 1: "wearing", 2: "idle", 3: "case", 4: "case_closed"}


def _crc_table() -> list[int]:
    table = []
    for i in range(256):
        crc = i << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) if crc & 0x8000 else (crc << 1)
        table.append(crc & 0xFFFF)
    return table


_CRC16 = _crc_table()


def crc16(data: bytes) -> int:
    """CRC-16/CCITT (poly 0x1021, init 0), as the buds compute it."""
    crc = 0
    for b in data:
        crc = (_CRC16[((crc >> 8) ^ b) & 0xFF] ^ (crc << 8)) & 0xFFFF
    return crc


def encode(msg_id: int, payload: bytes = b"", flags: int = 0) -> bytes:
    """Frame a message: SOM, little-endian length header, id, payload, CRC, EOM.

    The length counts id + payload + CRC and lives in the low 10 header bits;
    bits 12 and 13 are type flags (see Samsung's own client for their meaning),
    passed through `flags` as a 16-bit mask.
    """
    size = 1 + len(payload) + 2
    crc = crc16(bytes([msg_id]) + payload)
    header = (size & 0x3FF) | (flags & 0x3000)
    return bytes([SOM]) + header.to_bytes(2, "little") + bytes([msg_id]) + payload + crc.to_bytes(2, "little") + bytes([EOM])


class FrameParser:
    """Reassembles frames from an RFCOMM byte stream."""

    def __init__(self) -> None:
        self.buf = bytearray()

    def feed(self, data: bytes):
        self.buf.extend(data)
        while self.buf:
            start = self.buf.find(SOM)
            if start < 0:
                self.buf.clear()
                return
            if start:
                del self.buf[:start]
            if len(self.buf) < 4:
                return
            header = int.from_bytes(self.buf[1:3], "little")
            size = header & 0x3FF
            total = 3 + size + 1
            # Only bits 12 (response) and 13 (fragment) sit above the 10-bit size;
            # anything else set means this SOM byte was payload, not a frame start.
            if size < 3 or header & 0xCC00:
                del self.buf[:1]
                continue
            if len(self.buf) < total:
                return
            frame = bytes(self.buf[:total])
            # The CRC travels little-endian right after the payload.
            if frame[-1] != EOM or crc16(frame[3:-3]) != int.from_bytes(frame[-3:-1], "little"):
                # Not a frame after all; skip this SOM and resync on the next.
                del self.buf[:1]
                continue
            del self.buf[:total]
            yield frame[3], frame[4:-3], bool(header & 0x1000)



[Unit]
Description=omarchy-buds Galaxy Buds daemon
# The control link needs BlueZ on the system bus, which arrives with the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# A fixed interpreter in isolated mode: -I ignores PYTHONPATH/PYTHONHOME and the
# user site directory, and keeps the script's own directory off sys.path, so
# nothing in the session environment can choose the interpreter or preload code.
ExecStart=/usr/bin/python3 -I %h/.local/bin/omarchy-buds daemon
# The daemon spawns nothing, but the environment it starts with is still fixed.
Environment=PATH=/usr/bin:/bin
Restart=on-failure
RestartSec=5

# The status file names the paired device, so nothing the daemon creates is world-readable.
UMask=0077
StateDirectory=omarchy-buds
StateDirectoryMode=0700
ProtectSystem=strict
# strict leaves /home and /run/user to ProtectHome, so home needs this line;
# the script itself lives under ~/.local/bin and is only ever read.
ProtectHome=read-only
# systemd creates %t/omarchy-buds and exposes only that owner-only directory;
# the daemon never needs write access to sibling runtime sockets.
RuntimeDirectory=omarchy-buds
RuntimeDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The RFCOMM socket arrives from BlueZ over D-Bus; everything else is a local socket.
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH

[Install]
WantedBy=graphical-session.target

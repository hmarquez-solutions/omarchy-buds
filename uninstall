#!/bin/bash
# Undo everything setup installed: the two user services, the two scripts in
# ~/.local/bin, and the state directory. Files are removed only when they are
# proven to be ours (manifest hash, current source hash, or the hash of a
# version this plugin shipped before the manifest existed); anything else is
# reported and left alone. Nothing is deleted recursively.

set -euo pipefail

# Fixed tool paths, as in setup.
export PATH=/usr/bin:/bin

root=$(cd "$(dirname "$0")" && pwd)
bin="$HOME/.local/bin"
units="$HOME/.config/systemd/user"
state="$HOME/.local/state/omarchy-buds"
manifest="$state/install-manifest"

declare -a labels=(
  "bin/omarchy-buds"
  "bin/omarchy-buds-osd"
  "unit/omarchy-buds.service"
  "unit/omarchy-buds-osd.service"
)
declare -a sources=(
  "$root/daemon/omarchy-buds"
  "$root/daemon/omarchy-buds-osd"
  "$root/daemon/omarchy-buds.service"
  "$root/daemon/omarchy-buds-osd.service"
)
declare -a targets=(
  "$bin/omarchy-buds"
  "$bin/omarchy-buds-osd"
  "$units/omarchy-buds.service"
  "$units/omarchy-buds-osd.service"
)

manifest_hash() {
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
  awk -v label="$1" '$2 == label { print $1; exit }' "$manifest"
}

file_hash() {
  sha256sum -- "$1" | awk '{print $1}'
}

shipped="$root/daemon/shipped.sha256"
shipped_hash() {
  [[ -f "$shipped" && ! -L "$shipped" ]] || return 1
  awk -v h="$1" -v n="$2" '$1 == h && $2 == n { found = 1 } END { exit !found }' "$shipped"
}

ours() {
  local target=$1 label=$2 source=$3 current owned
  [[ -f "$target" && ! -L "$target" ]] || return 1
  current=$(file_hash "$target")
  owned=$(manifest_hash "$label" || true)
  [[ -n "$owned" && "$owned" == "$current" ]] && return 0
  [[ -f "$source" && "$(file_hash "$source")" == "$current" ]] && return 0
  shipped_hash "$current" "$(basename -- "$target")" && return 0
  return 1
}

systemctl --user disable --now omarchy-buds.service omarchy-buds-osd.service 2>/dev/null || true

declare -a kept=()
for i in "${!targets[@]}"; do
  target=${targets[$i]}
  [[ -e "$target" || -L "$target" ]] || continue
  if ours "$target" "${labels[$i]}" "${sources[$i]}"; then
    rm -f -- "$target"
  else
    kept+=("$target")
  fi
done

systemctl --user daemon-reload

# The state directory holds exactly what the daemon and setup put there. Remove
# those by name and then the directory itself; never delete recursively.
if [[ -d "$state" && ! -L "$state" ]]; then
  for f in "$state/status.json" "$state/install-manifest" "$state/install-manifest.tmp" \
           "$state"/.status.????????????????????????; do
    [[ -f "$f" && ! -L "$f" ]] && rm -f -- "$f"
  done
  rmdir -- "$state" 2>/dev/null || kept+=("$state (not empty)")
fi

if ((${#kept[@]})); then
  echo "Left in place because they are not proven to belong to omarchy-buds:" >&2
  printf '  %s\n' "${kept[@]}" >&2
fi

echo "omarchy-buds services and files are removed."
echo "To remove the bar plugin itself: omarchy plugin remove io.github.hmarquez-solutions.buds"
